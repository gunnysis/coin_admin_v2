{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TS 6.0부터 node_modules/@types 자동 포함이 제거되어 전역 타입(jest·process 등)은 명시 필요
    "types": ["jest", "node"],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-native",
    "jsxImportSource": "nativewind"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "backup/**/*",
    "node_modules/**",
    "android/**",
    "ios/**"
  ]
}
