  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "jest",
        "@types/jest",
        "@react-native-community/datetimepicker",
        "react-native-gesture-handler",
        "react-native-svg"
      ]
