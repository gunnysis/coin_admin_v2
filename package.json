{
  "name": "coin-admin",
  "version": "2.5.0",
  "main": "index.tsx",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
